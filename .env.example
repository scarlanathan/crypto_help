# =============================================================================
# Configuration de l'app web crypto (copier vers .env et adapter)
# =============================================================================

# --- Worker ------------------------------------------------------------------
# Intervalle entre deux cycles d'analyse, en secondes. 300 = 5 min.
# La plus courte stratégie est 15m, donc descendre sous 60s est inutile.
POLL_INTERVAL_SECONDS=300

# Liste des paires à suivre (séparées par des virgules).
# - /USDT : prix en dollars
# - /BTC, /ETH : paires cross (force relative vs BTC/ETH)
# Si vide, on prend SYMBOLS depuis config.py.
WATCHED_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,ADA/USDT,XRP/USDT,DOGE/USDT,AVAX/USDT,SUSHI/USDT,ETH/BTC,BNB/BTC,SOL/ETH

# Exchange ccxt à utiliser (binance, kraken, coinbase, okx). Fallback automatique.
EXCHANGE_ID=binance

# --- Email (Gmail SMTP) ------------------------------------------------------
# 1. Activez la "validation en 2 étapes" sur le compte Gmail expéditeur
# 2. Générez un "App password" : https://myaccount.google.com/apppasswords
# 3. Collez-le ci-dessous (16 caractères sans espace).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=expediteur@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Adresse(s) qui reçoivent les alertes (séparées par des virgules).
ALERT_TO=nathanhan02@gmail.com

# Anti-spam : minimum de secondes entre 2 mails. Si plusieurs transitions
# arrivent dans cette fenêtre, elles sont regroupées dans un seul mail.
ALERT_MIN_INTERVAL_SECONDS=60

# Si défini à 1, les alertes sont loggées uniquement (pas d'envoi réel).
# Utile pour tester sans saturer Gmail.
ALERT_DRY_RUN=0

# --- Serveur HTTP ------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
